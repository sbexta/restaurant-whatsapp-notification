# Copy this file to .env and fill in real values before running docker compose.

# Password for the shared PostgreSQL instance (app DB + Evolution API DB)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Public origin of the deployed frontend (Vercel URL), used for CORS
FRONTEND_ORIGIN=https://your-app.vercel.app

# Public IP or domain of this VM (no protocol, no trailing slash)
VM_HOST=203.0.113.10

# Evolution API global API key (any random secret string)
EVOLUTION_API_KEY=change-me-to-a-random-secret

# Host ports (change only if they clash with something else on the VM)
BACKEND_PORT=8081
N8N_PORT=5678
EVOLUTION_PORT=8080
